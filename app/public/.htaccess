# Static site (Nuxt generate) on Apache — endora.cz
# Modules are wrapped in <IfModule> so missing modules never cause a 500.

# Serve the branded 404 page generated from app/error.vue
ErrorDocument 404 /404.html

# Canonical host + HTTPS.
# Both www.marekcon.cz and marekcon.cz used to answer 200 with identical
# content, so every page existed under two URLs and inbound links split
# between them. The canonical tag already pointed at the non-www form; these
# rules enforce it.
#
# ORDER MATTERS: the www rule must come FIRST. That way http://www.example
# reaches https://example in a single 301 instead of hopping through
# https://www.example. %1 is the host captured without the leading "www.".
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> non-www (and straight to HTTPS in the same hop)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Redirect remaining plain HTTP to HTTPS (enable the SSL cert in endora first!)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Gzip compression for text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Cache hashed build assets (/_nuxt/*) for a long time; images a month
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
