# Copy this file to `.env` and fill in the values before running `npm run generate`.
# These are baked into the static build at generate time (the host has no runtime config).

# Production base URL — used for canonical links, og:image, sitemap.xml and robots.txt.
NUXT_PUBLIC_SITE_URL=https://marekcon.cz

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to keep analytics disabled. When set, GA loads with Consent Mode v2
# (no tracking until the visitor accepts cookies).
NUXT_PUBLIC_GTAG_ID=
